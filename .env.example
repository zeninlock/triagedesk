# Local fixture demo only. Compose binds published services to 127.0.0.1.
MODE=fixture
READ_ONLY=false
REVIEWER_TOKEN=local-demo-change-me
REVIEWER_NAME=local-maintainer
POSTGRES_USER=triagedesk
POSTGRES_PASSWORD=triagedesk
POSTGRES_DB=triagedesk
# Used outside Docker. Compose overrides this to the private db hostname.
DATABASE_URL=postgresql+psycopg://triagedesk:triagedesk@localhost:5433/triagedesk
ARTIFACT_DIR=artifacts
API_URL=http://localhost:8000
GITHUB_TOKEN=
# Verified public-repository mode: run scripts/setup-github-local.py first.
# The local fixture demo uses AUTH_MODE=local; never use its shared token for public hosting.
AUTH_MODE=local
AUTH_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
ALLOW_TOKEN_LOGIN=true
SESSION_HOURS=8
