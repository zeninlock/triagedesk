# Paste into Community Cloud's Advanced settings > Secrets; replace both placeholders.
# Never commit a populated secrets.toml file.
DATABASE_URL = "postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require"
AUTH_ENCRYPTION_KEY = "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
# Optional: enable GitHub App device sign-in after the token flow works.
GITHUB_CLIENT_ID = ""

# Required for automatic AI labeling; generate in your Groq account.
GROQ_API_KEY = "REPLACE_WITH_YOUR_GROQ_API_KEY"
AI_MODEL = "qwen/qwen3.8-27b"
AI_CONFIDENCE_THRESHOLD = 0.85
AI_BATCH_SIZE = 5
