# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Copy both URLs from the SAME Neon branch/database/role. Keep sslmode=require.
DATABASE_URL = "postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require"
MIGRATION_DATABASE_URL = "postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require"
AUTH_ENCRYPTION_KEY = "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
OPENAI_API_KEY = "REPLACE_WITH_YOUR_OPENAI_API_KEY"
AI_MODEL = "gpt-4.1-mini"
AI_CONFIDENCE_THRESHOLD = 0.85
AI_BATCH_SIZE = 5
AI_REQUEST_INTERVAL = 1
AUTO_SYNC_SECONDS = 60
# Optional: GitHub App client ID for browser device sign-in. Token sign-in works without it.
GITHUB_CLIENT_ID = ""
